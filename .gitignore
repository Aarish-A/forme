# macOS
.DS_Store
._*

# Xcode — user-specific state (never share these)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode — build products
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
# Package.resolved IS committed — it pins dependency versions for reproducible builds.

# Fastlane / distribution
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets — see Config/Secrets.example.xcconfig for the template
Config/Secrets.xcconfig
*.p8
*.p12
*.mobileprovision

# Tooling output
*.log
.claude/settings.local.json

# Scan diagnostics pulled off a device by `make diag`. Derived from a real
# photo library, so it never belongs in the repo.
#
# Anchored with a leading slash on purpose: an unanchored `diagnostics/`
# matches at any depth, and on a case-insensitive filesystem that silently
# swallowed the whole of `Forme/Diagnostics/` — source that the app does not
# build without.
/diagnostics/

# Test fixture photos and their labels. Real photographs of real people,
# including third parties — they never enter the repo, a commit, or an
# .xcresult. Path-scoped rather than a blanket image ignore so future
# legitimate assets aren't swallowed.
#
# `fixtures/` sits at the repo root and NOT under `Forme/`, `FormeTests/` or
# `FormeUITests/`, all three of which are synchronized groups: anything placed
# inside one is auto-added to that target. Putting 490 photos there breaks the
# build on duplicate resource names, and bundles every one of them into each
# .xcresult, which is the privacy problem this ignore exists to prevent.
/fixtures/
FormeTests/Fixtures/

# Worktrees — `claude --worktree` checks out here; see .worktreeinclude
.claude/worktrees/
# Per-worktree Makefile overrides (SIMULATOR, etc.)
Local.mk

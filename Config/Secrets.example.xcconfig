// Secrets.example.xcconfig
//
// Copy this file to Config/Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored; this template is committed.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Find both values in the Supabase dashboard under Project Settings > API.

// Your project host, WITHOUT the https:// prefix.
//
// Why no scheme: xcconfig treats `//` as the start of a comment anywhere on a
// line, so `https://abc.supabase.co` silently truncates to `https:` and the app
// ends up with a hostless URL. Writing the bare host sidesteps the trap
// entirely. SupabaseConfig adds https:// for you.
//
// If you must use a full URL (a custom domain on a different scheme, say), the
// escape splits the two slashes: `https:/$()/example.com` — note the `$()`
// sits BETWEEN them, not before both.
SUPABASE_URL = your-project-ref.supabase.co

// The anon / publishable key. This one is safe to ship in the app binary — it
// only grants what your Row Level Security policies allow. The *service role*
// key is not, and must never appear in this file or anywhere in the client.
SUPABASE_ANON_KEY = your-anon-key-here

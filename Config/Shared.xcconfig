// Shared.xcconfig
// Settings that apply to every target and every configuration.
// Build settings live here rather than in project.pbxproj so they are
// reviewable in a diff and cannot be changed accidentally from the Xcode UI.

// MARK: - Identity

FORME_BUNDLE_ID_PREFIX = com.forme
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Set your Apple Developer Team ID here (or leave blank and let Xcode pick it
// per-machine via Signing & Capabilities).
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// MARK: - Platform

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO

// MARK: - Swift language

// Swift 6 language mode: data races are compile-time errors, not runtime crashes.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// The Xcode 26 concurrency defaults. `MainActor` isolation by default means UI
// code needs no annotation; anything that should run off the main actor is
// marked explicitly with `nonisolated` or `@concurrent`.
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_EMIT_LOC_STRINGS = YES

// MARK: - Warnings

// Kept as warnings locally so they don't interrupt flow; CI passes
// SWIFT_TREAT_WARNINGS_AS_ERRORS=YES so they can never reach main.
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
GCC_TREAT_WARNINGS_AS_ERRORS = NO

CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE

// MARK: - Localization

LOCALIZATION_PREFERS_STRING_CATALOGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// MARK: - Supabase

// Real values go in Config/Secrets.xcconfig, which is gitignored.
// Copy Config/Secrets.example.xcconfig to get started.
// These empty defaults keep the build working before Supabase is wired up.
SUPABASE_URL =
SUPABASE_ANON_KEY =

// MARK: - Hygiene

ALWAYS_SEARCH_USER_PATHS = NO
DEAD_CODE_STRIPPING = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_NO_COMMON_BLOCKS = YES

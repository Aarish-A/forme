// Debug.xcconfig
// Local development builds: fast to compile, easy to debug.

#include "Shared.xcconfig"
#include? "Secrets.xcconfig"

ONLY_ACTIVE_ARCH = YES
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES

SWIFT_OPTIMIZATION_LEVEL = -Onone

// `singlefile`, not `incremental`: SwiftUI previews refuse to run without it.
// Since every view is supposed to carry a #Preview, previews not working would
// quietly hollow out that convention.
SWIFT_COMPILATION_MODE = singlefile
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1

MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
